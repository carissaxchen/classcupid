{
  "buildCommand": "pip install -r requirements.txt && python3 scripts/build_catalog.py && mkdir -p public && cp -r static public/static",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "app.py",
        "models.py",
        "helpers.py",
        "catalog.db",
        "templates/**",
        "data/json/harvard_college_concentrations.json",
        "data/json/harvard_schools.json",
        "data/json/*_Geneds.json"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
